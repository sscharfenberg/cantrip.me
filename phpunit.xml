<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!--
            Local suite — runs against in-memory SQLite (the <env> defaults
            below). Covers everything *except* tests/Feature/Services, which
            need real Scryfall data and a live MariaDB connection. Triggered
            by `composer test`.
        -->
        <testsuite name="Local">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Services</exclude>
        </testsuite>
        <!--
            Staging suite — runs only the tests that read real Scryfall data
            against MariaDB. Triggered by `composer test:mysql` on a host
            with DB_CONNECTION=mysql + a populated dataset. These tests
            never write to the DB, so they're safe to run on staging; the
            Local suite is excluded here so any test using RefreshDatabase
            cannot reach a live connection.
        -->
        <testsuite name="Staging">
            <directory>tests/Feature/Services</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
