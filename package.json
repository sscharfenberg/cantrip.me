{
    "name": "cantrip",
    "description": "cantrip.me - MtG collection manager",
    "license": "UNLICENSED",
    "private": true,
    "version": "1.2.0",
    "type": "module",
    "engines": {
        "node": "^26.1.0",
        "npm": "^11.13.0"
    },
    "author": {
        "name": "Sven Scharfenberg",
        "email": "admin@cantrip.me"
    },
    "scripts": {
        "dev": "npm run preinstall && vite --host",
        "build": "npm run preinstall && npm run lint && run-p type-check \"build-only {@}\" -- && npm run icons",
        "build-only": "vite build",
        "e2e:db:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
        "e2e:db:down": "docker compose -f docker-compose.e2e.yml down",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:report": "playwright show-report",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "type-check": "vue-tsc --build",
        "lint": "eslint 'resources/app/**/*.{js,ts,vue}' 'tests/e2e/**/*.ts' playwright.config.ts --fix && stylelint 'resources/app/**/*.{vue,scss}' --fix --quiet-deprecation-warnings",
        "icons": "node ./resources/build/icons.ts -v -i",
        "format": "prettier --write 'resources/app/**/*.{ts,vue,scss,json,md}'",
        "preinstall": "node ./resources/build/checkNodeVersion.ts"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@sscharfenberg/progressbar": "^0.2.0",
        "floating-vue": "^5.2.2",
        "normalize.css": "^8.0.1",
        "vue": "^3.5.41",
        "vue-draggable-plus": "^0.6.1",
        "vue-i18n": "^11.4.8",
        "vue-input-otp": "^0.4.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/jsdom": "^30.0.0",
        "@types/minimist": "^1.2.5",
        "@types/node": "^26.2.0",
        "@types/semver": "^7.8.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "chalk": "^5.6.2",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.10.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.2.0",
        "lightningcss": "^1.32.0",
        "minimist": "^1.2.8",
        "npm-run-all2": "^9.0.3",
        "prettier": "3.9.6",
        "sass-embedded": "^1.100.0",
        "semver": "^7.8.3",
        "sharp": "^0.35.3",
        "start-server-and-test": "^3.0.12",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "stylelint-order": "^8.1.1",
        "stylelint-scss": "^7.2.0",
        "svgo": "^4.0.2",
        "svgstore": "^3.0.1",
        "typescript": "~6.0.3",
        "vite": "^8.2.1",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.5"
    },
    "prettier": {
        "printWidth": 120,
        "tabWidth": 4,
        "semi": true,
        "singleQuote": false,
        "singleAttributePerLine": false,
        "trailingComma": "none",
        "bracketSpacing": true,
        "arrowParens": "avoid",
        "overrides": [
            {
                "files": "**/*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
