# /etc/systemd/system/cantrip-prod-schedule.timer
#
# Committed in resources/scripts/ for review; the live copy is on debbie. Install a
# change there, or it does nothing.
#
# Every minute, on the minute. Enable with:
#   systemctl enable --now cantrip-prod-schedule.timer
[Unit]
Description=cantrip.me production: run the Laravel scheduler every minute

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s

[Install]
WantedBy=timers.target
