# /etc/systemd/system/cantrip-waf-report.timer
#
# Committed in resources/scripts/ for review; the live copy is on debbie. Install a
# change there, or it does nothing.
#
# Daily at 07:00 Berlin time; the zone is named, so the time holds across
# daylight saving. A run missed while the server was down follows at boot.
# Enable with:
#   systemctl enable --now cantrip-waf-report.timer
[Unit]
Description=cantrip.me production: daily report of the requests the WAF refused

[Timer]
OnCalendar=*-*-* 07:00:00 Europe/Berlin
Persistent=true

[Install]
WantedBy=timers.target
