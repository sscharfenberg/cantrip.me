# /etc/systemd/system/cantrip-prod-schedule.service
#
# Committed in resources/scripts/ for review; the live copy is on debbie. Install a
# change there, or it does nothing. Enable with:
#   systemctl enable --now cantrip-prod-schedule.service
#
# cantrip.me production: the Laravel scheduler as one long-running
# `artisan schedule:work`. Every minute it starts a fresh `schedule:run`, whether
# or not the previous one has finished, so a long task never costs the minutes
# after it. The tasks are in routes/console.php: the temp-upload cleanup,
# db:backup (00:15 Berlin), session GC (03:00) and scryfall:update (04:00), which
# runs for up to half an hour.
#
# Not a timer starting a oneshot `schedule:run` every minute: systemd does not
# start a unit that is still running, so every minute of a long task would be
# skipped, not queued. Nor ->runInBackground() on the long task under such a
# oneshot: when a oneshot's main process exits, systemd kills what is left in
# its control group — the backgrounded run, and its onFailure alert with it.
#
# Each run is a new process, so a deploy needs no restart here: the next minute
# runs the new code.
#
# KillMode=mixed: a stop sends SIGTERM to schedule:work alone, which then starts
# nothing new and waits for the runs in flight; whatever is still running after
# TimeoutStopSec is killed. With the default, every run would get SIGTERM at once.
#
# A crash restarts it quietly; a crash loop alerts. RestartMode=direct restarts
# without passing through the failed state, which with the default mode starts
# OnFailure= on every single crash — a push every ten seconds. Five starts within
# five minutes is the start limit, and hitting it leaves the unit failed, which
# is when OnFailure= runs notify-failure@ (/usr/local/sbin/notify, the server's
# one alert path). A scheduler that never comes back is also what the db:backup
# healthchecks.io check notices by itself, within a day.
[Unit]
Description=cantrip.me production: Laravel scheduler (schedule:work)
After=postgresql.service
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=cantrip
Group=cantrip
WorkingDirectory=/var/www/cantrip.prod
# --whisper: no "No scheduled commands are ready to run." in the journal every minute.
ExecStart=/usr/bin/php artisan schedule:work --whisper --no-interaction
Restart=always
RestartSec=10
RestartMode=direct
KillMode=mixed
TimeoutStopSec=2min
# Storage and the media folders carry default ACLs that decide the modes;
# this only keeps anything else out of reach of "other".
UMask=0007
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
