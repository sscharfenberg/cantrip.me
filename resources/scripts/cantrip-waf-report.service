# /etc/systemd/system/cantrip-waf-report.service
#
# Committed in resources/scripts/ for review; the live copy is on debbie. Install a
# change there, or it does nothing.
#
# cantrip.me production: the daily report of the requests the WAF refused
# (/usr/local/sbin/cantrip-waf-report), started by cantrip-waf-report.timer.
# Root, because the audit log is root:adm 640 and the Discord webhook is in
# prod's .env. Its window start lives in /var/lib/cantrip-waf-report.
[Unit]
Description=cantrip.me production: report the requests the WAF refused
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cantrip-waf-report
StateDirectory=cantrip-waf-report
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
